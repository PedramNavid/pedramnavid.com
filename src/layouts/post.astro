---
import type { CollectionEntry } from 'astro:content';
import { SITE } from '$/config'
import MainLayout from '$/components/MainLayout.astro'
import BaseHead from '$/components/BaseHead.astro'
import Prose from '$/components/Prose.astro'
import EditUrl from '$/components/EditLink.astro'
import { getImagePath } from 'astro-opengraph-images'

interface Props {
    meta?: {
        id: string,
        slug: string,
        collection: string
    },
    content: CollectionEntry<'blog'>['data'],
}
const { content, meta } = Astro.props

const { url, site } = Astro;
const ogImage = getImagePath({ url, site });

const dateStr = new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
}).format(new Date(content.date))
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead {...content} title={ content.title ? `${ SITE.title } | ${content.title}` : SITE.title } image={ogImage} />
    </head>
    <MainLayout>
        <div class="post">
            <a href="/blog" class="post__back">
                &larr; [ RETURN_TO_ARCHIVE ]
            </a>

            <header class="post__header">
                <h1 class="post__title">{content.title}</h1>
                <time class="post__date">// {dateStr.toUpperCase()}</time>
            </header>

            {content.image && (
                <img class="post__hero" src={content.image} alt={content.title} />
            )}

            <Prose>
                <slot />
            </Prose>

            <footer class="post__footer">
                {content.tags && content.tags.length > 0 && (
                    <div class="post__tags">
                        {content.tags.map(tag => (
                            <a href={`/tags/${tag}`} class="post__tag">{tag}</a>
                        ))}
                    </div>
                )}
                {meta?.collection && meta?.id && (
                    <EditUrl label="Suggest changes on GitHub" editUrl={`${SITE.siteRepoUrl}/tree/main/src/content/${meta?.collection}/${meta?.id}`}/>
                )}
            </footer>
        </div>
    </MainLayout>
</html>

<style>
    .post {
        @apply py-8 md:py-12;
    }
    .post__back {
        @apply inline-block font-mono text-xs tracking-widest text-charcoal-faint no-underline mb-8 transition-colors;
    }
    .post__back:hover {
        @apply text-charcoal;
    }
    .post__header {
        @apply mb-10;
    }
    .post__title {
        @apply font-serif text-3xl md:text-4xl lg:text-5xl font-bold text-charcoal leading-tight mb-4;
    }
    .post__date {
        @apply font-mono text-sm tracking-widest text-coral;
    }
    .post__hero {
        @apply w-full rounded-lg mb-10;
    }
    .post__footer {
        @apply mt-12 pt-8 border-t border-cream-200;
    }
    .post__tags {
        @apply flex flex-wrap gap-2 mb-4;
    }
    .post__tag {
        @apply font-mono text-xs tracking-wide text-charcoal-faint bg-cream-200 px-3 py-1 no-underline transition-colors;
    }
    .post__tag:hover {
        @apply text-charcoal bg-cream-300;
    }
</style>
