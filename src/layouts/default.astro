---
import { SITE } from '$/config'
import BaseHead from '$/components/BaseHead.astro';
import MainLayout from '$/components/MainLayout.astro';
import { getImagePath } from 'astro-opengraph-images';

const { content, showPageHeader = true } = Astro.props
const { url, site } = Astro;
const ogImage = getImagePath({ url, site });
---
<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={ content.title ? `${ SITE.title } | ${content.title}` : SITE.title } description={ content.description } image={ogImage} />
    </head>
    <MainLayout>
        {showPageHeader &&
            <div class="page__header">
                <h1 class="page__title">{content.title}</h1>
                {content.description && <p class="page__desc">{content.description}</p>}
            </div>
        }
        <slot />
    </MainLayout>
</html>

<style>
    .page__header {
        @apply py-12 mb-8;
    }
    .page__title {
        @apply font-serif text-4xl md:text-5xl font-bold text-charcoal mb-3;
    }
    .page__desc {
        @apply text-lg text-charcoal-muted;
    }
</style>
