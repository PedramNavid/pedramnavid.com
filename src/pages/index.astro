---
export const prerender = true

import { getCollection } from 'astro:content'
import DefaultPageLayout from '$/layouts/default.astro'
import PostPreview from '$/components/PostPreview.astro'
import { calculateReadingTime, getMonthName } from '$/utils'

const title = 'Home'
const description = 'Writing about software engineering, data, AI, and building things.'

const allPosts = await getCollection('blog')
const posts = allPosts.sort((a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf())
const recentPosts = posts.slice(0, 4)
---
<DefaultPageLayout content={{ title, description }} showPageHeader={false}>
    <div class="home">
        <div class="home__intro">
            <h1 class="home__heading">
                Hi, I'm <span class="home__name">Pedram</span>.
            </h1>
            <p class="home__bio">
            I work at <a href="https://anthropic.com" class="home__link">Anthropic</a>. I enjoy educating techincal
            audiences on complex topics. I built the public <a href="https://platform.claude.com/cookbook" class="home__link">Claude Cookbooks</a> site,
            and you'll often find me writing on <a href="https://x.com/pdrmnvd" class="home__link">X</a>.
            </p>
            <p class="home__bio">
                This is my corner of the internet; a place for
                <a href="/blog" class="home__link">writing</a>,
                <a href="/projects" class="home__link">projects</a>,
                and notes on what I'm <a href="/now" class="home__link">working on now</a>.
            </p>
        </div>

        <div class="home__grid">
            <div class="home__section-label">
                <span class="home__label">// RECENT WRITING</span>
            </div>
            <div class="home__cards">
                {recentPosts.map(post => (
                    <PostPreview post={post} asCard={true} />
                ))}
            </div>
            <a href="/blog" class="home__view-all">
                View all writing &rarr;
            </a>
        </div>
    </div>
</DefaultPageLayout>

<style>
    .home {
        @apply py-12 md:py-20;
    }
    .home__intro {
        @apply max-w-2xl mb-16 md:mb-24;
    }
    .home__heading {
        @apply font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-charcoal mb-6 leading-tight;
    }
    .home__name {
        @apply text-coral;
    }
    .home__bio {
        @apply text-lg md:text-xl text-charcoal-light leading-relaxed mb-4;
    }
    .home__link {
        @apply text-coral font-medium no-underline;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
    }
    .home__link:hover {
        border-bottom-color: currentColor;
    }
    .home__grid {
        @apply mt-8;
    }
    .home__section-label {
        @apply mb-6;
    }
    .home__label {
        @apply font-mono text-xs tracking-widest text-coral uppercase;
    }
    .home__cards {
        @apply grid grid-cols-1 md:grid-cols-2 gap-4;
    }
    .home__view-all {
        @apply inline-block mt-8 font-mono text-sm text-charcoal-muted no-underline tracking-wide transition-colors;
    }
    .home__view-all:hover {
        @apply text-coral;
    }
</style>
