---
import type { CollectionEntry } from 'astro:content'
import { getMonthName, calculateReadingTime } from '$/utils'

interface Props {
    post: CollectionEntry<'blog'>,
    asCard?: boolean
}

const { post: { data: post, slug, body }, asCard = false } = Astro.props
const readingTime = calculateReadingTime(body)
const date = new Date(post.date)
const formattedDate = `${getMonthName(post.date)} ${date.getDate()}, ${date.getFullYear()}`
---
{asCard ? (
    <a href={`/blog/${slug}`} class="card">
        <span class="card__category">
            {post.category || 'Writing'}
        </span>
        <h3 class="card__title">{post.title}</h3>
        <p class="card__desc">{post.description}</p>
        <div class="card__meta">
            <time class="card__date">{formattedDate}</time>
            <span class="card__reading-time">{readingTime} min</span>
        </div>
    </a>
) : (
    <a href={`/blog/${slug}`} class="list-item">
        <time class="list-item__date">{formattedDate}</time>
        <div class="list-item__content">
            <h3 class="list-item__title">{post.title}</h3>
            <p class="list-item__desc">{post.description}</p>
        </div>
        <span class="list-item__arrow">&rarr;</span>
    </a>
)}

<style>
    /* Card style */
    .card {
        @apply block p-6 bg-cream-50 border border-cream-200 no-underline transition-all;
    }
    .card:hover {
        @apply border-cream-400 shadow-sm;
        transform: translateY(-2px);
    }
    .card__category {
        @apply font-mono text-[10px] tracking-widest uppercase text-charcoal-faint;
    }
    .card__title {
        @apply font-serif text-xl font-bold text-charcoal mt-2 mb-2 leading-snug;
    }
    .card:hover .card__title {
        @apply text-coral;
    }
    .card__desc {
        @apply text-sm text-charcoal-muted leading-relaxed line-clamp-2 mb-4;
    }
    .card__meta {
        @apply flex items-center gap-3;
    }
    .card__date {
        @apply font-mono text-xs text-coral;
    }
    .card__reading-time {
        @apply font-mono text-xs text-charcoal-faint;
    }

    /* List style */
    .list-item {
        @apply flex items-start gap-6 py-4 no-underline transition-colors border-b border-cream-200;
    }
    .list-item:last-child {
        @apply border-b-0;
    }
    .list-item:hover .list-item__title {
        @apply text-coral;
    }
    .list-item__date {
        @apply font-mono text-sm text-charcoal-faint whitespace-nowrap pt-0.5 w-32 flex-shrink-0;
    }
    .list-item__content {
        @apply flex-1 min-w-0;
    }
    .list-item__title {
        @apply font-serif text-lg font-semibold text-charcoal mb-1 transition-colors;
    }
    .list-item__desc {
        @apply text-sm text-charcoal-muted line-clamp-1;
    }
    .list-item__arrow {
        @apply text-charcoal-faint pt-1 opacity-0 transition-opacity;
    }
    .list-item:hover .list-item__arrow {
        @apply opacity-100;
    }
</style>
