---
import { SITE } from '$/config'
---
<footer class="footer">
    <div class="footer__content">
        <p class="footer__copyright">
            &copy; {new Date().getFullYear()} {SITE.name}
        </p>
        <div class="footer__links">
            <a href={SITE.githubUrl} class="footer__link" target="_blank" rel="noopener">GitHub</a>
            <a href={`https://twitter.com/${SITE.authorTwitter}`} class="footer__link" target="_blank" rel="noopener">Twitter</a>
            <a href="https://www.linkedin.com/in/pedramnavid/" class="footer__link" target="_blank" rel="noopener">LinkedIn</a>
        </div>
    </div>
</footer>

<style>
    .footer {
        @apply py-10 mt-20 border-t border-cream-300;
    }
    .footer__content {
        @apply flex items-center justify-between;
    }
    .footer__copyright {
        @apply font-mono text-xs text-charcoal-faint tracking-wide;
    }
    .footer__links {
        @apply flex items-center gap-4;
    }
    .footer__link {
        @apply font-mono text-xs text-charcoal-faint no-underline tracking-wide transition-colors;
    }
    .footer__link:hover {
        @apply text-charcoal;
    }
</style>
