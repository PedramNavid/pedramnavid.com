---
import { SITE, NAV_ITEMS } from '$/config'
---

<header class="header">
    <div class="header__content">
        <a href="/" class="header__logo">
            <span class="header__logo-accent"></span>
            <span class="header__logo-text">{SITE.name.toUpperCase()}</span>
        </a>
        <nav class="header__nav">
            {Object.keys(NAV_ITEMS).map(key => (
                <a
                    class:list={[
                        'header__nav-link',
                        Astro.url.pathname === NAV_ITEMS[key].path ||
                        (NAV_ITEMS[key].path !== '/' && Astro.url.pathname.startsWith(NAV_ITEMS[key].path))
                            ? 'header__nav-link--active' : ''
                    ]}
                    href={NAV_ITEMS[key].path}
                >
                    {NAV_ITEMS[key].title.toUpperCase()}
                </a>
            ))}
        </nav>
        <div class="header__social">
            <a href={SITE.githubUrl} class="header__social-link" target="_blank" rel="noopener">GitHub</a>
            <a href={`https://twitter.com/${SITE.authorTwitter}`} class="header__social-link" target="_blank" rel="noopener">Twitter</a>
        </div>
    </div>
</header>

<style>
    .header {
        @apply py-5 border-b border-cream-300;
    }
    .header__content {
        @apply flex items-center justify-between gap-6;
    }
    .header__logo {
        @apply flex items-center gap-2 no-underline;
    }
    .header__logo-accent {
        @apply w-3 h-3 bg-coral rounded-sm flex-shrink-0;
    }
    .header__logo-text {
        @apply font-mono text-sm font-semibold tracking-wider text-charcoal;
    }
    .header__nav {
        @apply flex items-center gap-6;
    }
    .header__nav-link {
        @apply font-mono text-xs tracking-widest text-charcoal-muted no-underline transition-colors;
    }
    .header__nav-link:hover {
        @apply text-charcoal;
    }
    .header__nav-link--active {
        @apply text-charcoal;
    }
    .header__social {
        @apply hidden md:flex items-center gap-4;
    }
    .header__social-link {
        @apply font-mono text-xs tracking-wide text-charcoal-faint no-underline transition-colors;
    }
    .header__social-link:hover {
        @apply text-charcoal;
    }
</style>
