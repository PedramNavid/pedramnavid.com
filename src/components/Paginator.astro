---
const { page } = Astro.props
---
<nav class="pagination" aria-label="Pagination">
    <div class="pagination__info">
        <span class="pagination__text">Page {page.currentPage} of {page.lastPage}</span>
    </div>
    <div class="pagination__actions">
        {page.url.prev ? (
            <a class="pagination__link" href={page.url.prev} title="Go to Previous">
                <span aria-hidden="true">&larr;</span>
                <span>Previous</span>
            </a>
        ) : (
            <span class="pagination__link pagination__link--disabled">
                <span aria-hidden="true">&larr;</span>
                <span>Previous</span>
            </span>
        )}
        {page.url.next ? (
            <a class="pagination__link" href={page.url.next} title="Go to Next">
                <span>Next</span>
                <span aria-hidden="true">&rarr;</span>
            </a>
        ) : (
            <span class="pagination__link pagination__link--disabled">
                <span>Next</span>
                <span aria-hidden="true">&rarr;</span>
            </span>
        )}
    </div>
</nav>

<style>
    .pagination {
        @apply flex items-center justify-between py-8 mt-8 border-t border-cream-200;
    }
    .pagination__info {
        @apply font-mono text-sm text-charcoal-faint;
    }
    .pagination__actions {
        @apply flex gap-3;
    }
    .pagination__link {
        @apply inline-flex items-center gap-2 px-4 py-2 font-mono text-sm text-charcoal-light bg-cream-50 border border-cream-200 transition-colors no-underline;
    }
    .pagination__link:hover {
        @apply bg-cream-200 text-charcoal;
    }
    .pagination__link--disabled {
        @apply opacity-40 cursor-not-allowed;
    }
    .pagination__link--disabled:hover {
        @apply bg-cream-50;
    }
</style>
