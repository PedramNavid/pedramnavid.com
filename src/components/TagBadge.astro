---
interface Props {
    tag: string;
    href?: string;
    size?: 'sm' | 'md' | 'lg';
}

const { tag, href, size = 'sm' } = Astro.props;
const sizeClass = {
    'sm': 'text-xs px-2 py-0.5',
    'md': 'text-xs px-3 py-1',
    'lg': 'text-sm px-4 py-1.5'
}[size];

const Element = href ? 'a' : 'span';
---

<Element
    class={`tag-badge ${sizeClass}`}
    href={href}
    title={tag}
>
    {tag}
</Element>

<style>
    .tag-badge {
        @apply inline-flex items-center font-mono tracking-wide bg-cream-200 text-charcoal-muted transition-colors;
    }
    a.tag-badge {
        @apply no-underline;
    }
    a.tag-badge:hover {
        @apply bg-cream-300 text-charcoal;
    }
</style>
